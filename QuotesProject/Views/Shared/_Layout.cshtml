<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuotesProject</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">

                <!-- Only Nav Item (Brand) -->
                <a class="navbar-brand fw-bold"
                   asp-controller="Quote"
                   asp-action="Index">
                    Quotes Manager
                </a>

                @if (User.Identity.IsAuthenticated)
                {
                    <div class="d-flex align-items-center">
                        <span class="navbar-text me-3">
                            @User.Identity.Name @(User.IsInRole("Admin") ? "(Admin)" : "(User)")
                        </span>

                        <!-- Anti-forgery token so the logout POST passes [ValidateAntiForgeryToken] -->
                        @Html.AntiForgeryToken()

                        <button class="btn btn-outline-secondary btn-sm" onclick="logout()">
                            Logout
                        </button>
                    </div>

                    <script>
                        function logout() {
                            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                            fetch("/Login/Logout", {
                                method: "POST",
                                headers: { "RequestVerificationToken": token }
                            })
                            .then(() => window.location.href = "/Login");
                        }
                    </script>
                }

            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>